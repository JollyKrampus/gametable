<appSettings>
  <!-- GameTable's release settings. Upstream's come from a private archive the public build never
       sees, so without these a release build is in offline mode with localhost addresses. -->
  <!-- Updates come from GameTable's own feed, never Playnite's, so an upstream release cannot
       replace GameTable. Until a feed is published there, an update check finds nothing. -->
  <add key="UpdateUrl" value="https://raw.githubusercontent.com/JollyKrampus/gametable/master/update/" />
  <add key="UpdateUrl2" value="https://raw.githubusercontent.com/JollyKrampus/gametable/master/update/" />
  <!-- Playnite's public add-on catalogue: the same libraries, metadata sources, extensions and
       themes Playnite users install. Diagnostics are never uploaded (Branding.UploadsDiagnostics). -->
  <add key="ServicesUrl" value="https://api.playnite.link/api" />
  <add key="DocsRootUrl" value="https://api.playnite.link/docs/" />
  <add key="UpdateBranch" value="stable" />
  <add key="ThrowAllErrors" value="False" />
  <add key="OfflineMode" value="False" />
  <add key="PipeEndpoint" value="net.pipe://localhost/GameTablePipe" />
  <add key="AppBranch" value="master" />
  <add key="wcf:useBestMatchNamedPipeUri" value="true" />
</appSettings>
